# Files that exist for the repository, not for the shipped theme. Without these,
# GitHub's "Download ZIP" (which is git archive) hands users the repo scaffolding,
# and a package built from it fails review on WordPress.org.
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.github/           export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/phpcs.ruleset.xml  export-ignore

# layout/css/*.css and layout/js/*.js are the sources for the minified files the
# theme enqueues, and deliberately stay in the package: WordPress.org requires
# the sources for any compiled asset to ship with the theme.
